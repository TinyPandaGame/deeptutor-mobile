{
  "name": "deeptutor-mobile",
  "version": "0.4.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@types/katex": "0.16.8",
    "chart.js": "4.6.1",
    "expo": "~57.0.31",
    "expo-asset": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.23",
    "expo-constants": "~57.0.22",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.26",
    "expo-video": "~57.0.5",
    "katex": "0.19.1",
    "mermaid": "11",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --lan --port 8086",
    "android": "python3 scripts/build-android.py",
    "ios": "python3 scripts/run-ios.py",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "check:source": "node scripts/source-check.mjs",
    "check:history": "node scripts/source-check.mjs --history",
    "export:source": "node scripts/export-source.mjs",
    "mock": "node scripts/mock-service.mjs",
    "bundle:content": "node scripts/bundle-math-style.cjs && node scripts/bundle-diagrams.cjs",
    "postinstall": "npm run bundle:content",
    "release:android": "python3 scripts/release-android.py",
    "export:ios": "python3 scripts/export-ios-project.py",
    "prepare:ios": "python3 scripts/prepare-ios.py"
  },
  "private": true,
  "license": "Apache-2.0",
  "deeptutorCompatibility": "1.7.2"
}
